# Application
APP_NAME=payguard-copilot
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (application database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payguard
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=payguard

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
# Use localhost for host-side tools (make ingest). Compose overrides to service DNS.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=payguard_docs

# LLM / RAG (Gemini default; OpenAI optional)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_GEMINI=models/text-embedding-004
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2
RAG_DOCS_DIR=data/raw_docs

# Phase 3: Advanced Retrieval Feature Flags
RETRIEVAL_MODE=dense
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=20
PARENT_CHILD_ENABLED=false
CHILD_CHUNK_TOKENS=200
CHILD_CHUNK_OVERLAP=50
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
TEMPORAL_FILTER_ENABLED=false
CACHE_ENABLED=false
CACHE_SIMILARITY_THRESHOLD=0.998
CACHE_TTL_SECONDS=3600
INGEST_VERSION=1.0.0

# Phase 4: Evaluation & Judge Settings
JUDGE_PROVIDER=gemini
# JUDGE_MODEL has no default and must be explicitly set to a pinned model (e.g. gemini-1.5-flash-002, gpt-4o-mini)
JUDGE_MODEL=
JUDGE_RPM=5
JUDGE_RPD=20
JUDGE_TIMEOUT_SECONDS=60

# Langfuse
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=changeme_langfuse_db_password
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_SECRET=changeme_nextauth_secret_min_32_chars
LANGFUSE_SALT=changeme_langfuse_salt
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
